#!/usr/bin/env python3
"""greet: print a greeting for NAME with an optional --upper flag."""

from __future__ import annotations

import argparse


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="greet", description="Print a greeting.")
    parser.add_argument("name", help="who to greet")
    parser.add_argument("--upper", action="store_true", help="shout the greeting")
    return parser


def greet(name: str, upper: bool = False) -> str:
    name = name.strip()
    if not name:
        raise ValueError("name must not be empty")
    text = f"Hello, {name}!"
    return text.upper() if upper else text


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        print(greet(args.name, args.upper))
    except ValueError as error:
        print(f"error: {error}", flush=True)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
